# NexaSim .dockerignore
# Exclude build artifacts, dependencies, caches, and test results

# Git and IDE metadata
.git/
.github/
.vscode/
.devcontainer/

# Build outputs
build/
bin/
lib/
cmake-build-*/
out/
dist/

# Studio Frontend artifacts and dependencies
studio/node_modules/
studio/dist/
studio/.vite/

# Python caches and virtual environments
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
env/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Simulation outputs and large vector traces
scenarios/generated/*/results/
*.vec
*.vci
*.sca
*.log
output/

# Package manager and OS caches
.conan2/
.cache/
.DS_Store
Thumbs.db
