          "maximum": 90.0,
          "minimum": -90.0,
          "title": "Lat Min",
          "type": "number"
        },
        "lat_max": {
          "maximum": 90.0,
          "minimum": -90.0,
          "title": "Lat Max",
          "type": "number"
        },
        "lon_min": {
          "maximum": 180.0,
          "minimum": -180.0,
          "title": "Lon Min",
          "type": "number"
        },
        "lon_max": {
          "maximum": 180.0,
          "minimum": -180.0,
          "title": "Lon Max",
          "type": "number"
        },
        "attenuation_db": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": 40.0,
          "title": "Attenuation Db"
        }
      },
      "required": [
        "name",
        "lat_min",
        "lat_max",
        "lon_min",
        "lon_max"
      ],
      "title": "BlindSpotConfig",
      "type": "object"
    },
    "ConstellationConfig": {
      "additionalProperties": false,
