        "walkerF": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Walkerf"
        },
        "walkerAltitudeKm": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Walkeraltitudekm"
        },
        "walkerInclinationDeg": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Walkerinclinationdeg"
        },
        "isl": {
          "anyOf": [
            {
              "$ref": "#/$defs/ISLConfig"
            },
            {
              "type": "null"
            }
          ]
