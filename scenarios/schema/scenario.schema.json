{
  "$defs": {
    "AreaConfig": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "description": "Geographic area name",
          "title": "Name",
          "type": "string"
        },
        "center_lat": {
          "description": "Center latitude in degrees",
          "maximum": 90.0,
          "minimum": -90.0,
          "title": "Center Lat",
          "type": "number"
        },
        "center_lon": {
          "description": "Center longitude in degrees",
          "maximum": 180.0,
          "minimum": -180.0,
          "title": "Center Lon",
          "type": "number"
        },
        "altitude_m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": 0.0,
          "description": "Mean reference altitude in meters",
          "title": "Altitude M"
        },
        "bbox": {
          "description": "[min_lon, min_lat, max_lon, max_lat]",
          "items": {
            "type": "number"
          },
          "maxItems": 4,
          "minItems": 4,
          "title": "Bbox",
          "type": "array"
        },
        "elevation_mask_deg": {
          "anyOf": [
            {
              "maximum": 90.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": 15.0,
          "description": "Orographic terrain elevation mask in degrees",
          "title": "Elevation Mask Deg"
        },
        "environment_profile": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "suburban",
          "description": "3GPP propagation profile: urban, suburban, rural, alpine",
          "title": "Environment Profile"
        }
      },
      "required": [
        "name",
        "center_lat",
        "center_lon",
        "bbox"
      ],
      "title": "AreaConfig",
      "type": "object"
    },
    "BlindSpotConfig": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "description": "Blind spot name",
          "title": "Name",
          "type": "string"
        },
