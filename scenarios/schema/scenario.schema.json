          "type": "array"
        },
        "types": {
          "items": {
            "$ref": "#/$defs/GNBTypeConfig"
          },
          "title": "Types",
          "type": "array"
        }
      },
      "title": "GNBDeploymentConfig",
      "type": "object"
    },
