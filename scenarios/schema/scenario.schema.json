          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Satellite onboard edge computing capacity in GFLOPS / MIPS",
          "title": "Mec Cpu Gflops"
        },
        "isl_routing_mode": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ISL routing topology",
          "title": "Isl Routing Mode"
        }
      },
      "title": "ConstellationConfig",
      "type": "object"
    },
    "DualConnectivityConfig": {
      "additionalProperties": false,
