    <vType id="car" accel="2.4" decel="4.5" sigma="0.5" length="4.5" minGap="2.5" maxSpeed="33.3" color="0,150,220"/>

    <route id="r_corr_fwd" edges="e_corr_1 e_corr_2"/>
    <route id="r_corr_rev" edges="e_corr_rev_2 e_corr_rev_1"/>

    <!-- Priority Ambulance -->
