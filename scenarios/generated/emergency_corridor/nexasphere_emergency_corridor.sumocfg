<configuration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/sumoConfiguration.xsd">
    <input>
        <net-file value="nexasphere_emergency_corridor.net.xml"/>
        <route-files value="nexasphere_emergency_corridor.rou.xml"/>
    </input>
    <output>
        <fcd-output value="trace_fcd.xml"/>
        <fcd-output.geo value="true"/>
    </output>
    <time>
        <begin value="0"/>
        <end value="180"/>
        <step-length value="0.1"/>
    </time>
    <gui_only>
        <start value="true"/>
        <gui-settings-file value="nexasphere_emergency_corridor.view.xml"/>
    </gui_only>
</configuration>
